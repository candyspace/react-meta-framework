{
    "name": "@candyspace/react-meta-framework",
    "version": "2.0.5",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "author": "Charles Jaye",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/candyspace/react-meta-framework.git"
    },
    "private": false,
    "type": "module",
    "scripts": {
        "clean": "pnpx del-cli@latest --force \"**/pnpm-lock.yaml\" \"**/storybook-static\" \"**/test-results.xml\" \"**/*.log\" \"**/node_modules\" \"**/dist\" \"**/.husky/_\" \"**/chromatic-build-*.xml\" \"**/verdaccio/storage\" \"**/verdaccio/htpasswd\" \"**/verdaccio/config.yaml\"",
        "bump": "sed -i -E 's/\"version\": *\"[^\"]*\"/\"version\": \"'\"${GITHUB_REF_NAME#v}\"'\"/' package.json && rm -rf package.json-E",
        "prepare:all": "pnpm run prepare:verdaccio && pnpm run prepare:husky && pnpm run prepare:generation && pnpm run prepare:playwright",
        "prepare:verdaccio": "sudo apt-get update || true && sudo apt-get install -y expect || true && chmod +x verdaccio/init verdaccio/login",
        "prepare:husky": "husky || true && chmod +x .husky/pre-push",
        "prepare:generation": "pnpx jiti bin/generate.ts",
        "prepare:playwright": "pnpx playwright install --with-deps",
        "lint": "tsc -b && pnpm run lint:check",
        "lint:check": "pnpm eslint .",
        "lint:fix": "pnpm eslint . --fix",
        "test": "pnpm run prepare:all && pnpm run lint && pnpm run test:unit",
        "test:unit": "vitest --no-watch",
        "build": "pnpm run test && pnpm run build:bundle",
        "build:storybook": "storybook build -c ./playground/.storybook",
        "build:bundle": "unbuild",
        "dev": "pnpm run prepare:all && pnpm run build:bundle && pnpm run dev:storybook",
        "dev:storybook": "storybook dev -p 6006 -c ./playground/.storybook",
        "dev:verdaccio": "verdaccio --listen 30333",
        "prepublishOnly": "pnpx del-cli --force \"**/dist\" && pnpm run prepare:all && pnpm run build:bundle",
        "publish:verdaccio": "pnpm run dev:verdaccio & sleep 5 && verdaccio/init || true && verdaccio/login && pnpm publish --access public --tag latest --no-git-checks --registry http://localhost:30333",
        "publish:chromatic": "pnpx chromatic@latest --force-rebuild",
        "publish:npm": "pnpm publish --access public --tag latest --no-git-checks --registry npm.pkg.github.com"
    },
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": "^24.15.0"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./addons/state": {
            "types": "./dist/addons/state/index.d.mts",
            "import": "./dist/addons/state/index.mjs",
            "require": "./dist/addons/state/index.cjs",
            "default": "./dist/addons/state/index.mjs"
        },
        "./addons/state/preview": {
            "types": "./dist/addons/state/preview.d.mts",
            "import": "./dist/addons/state/preview.mjs",
            "require": "./dist/addons/state/preview.cjs",
            "default": "./dist/addons/state/preview.mjs"
        },
        "./addons/state/manager": {
            "types": "./dist/addons/state/manager.d.mts",
            "import": "./dist/addons/state/manager.mjs",
            "require": "./dist/addons/state/manager.cjs",
            "default": "./dist/addons/state/manager.mjs"
        },
        "./addons/breakpoints": {
            "types": "./dist/addons/breakpoints/index.d.mts",
            "import": "./dist/addons/breakpoints/index.mjs",
            "require": "./dist/addons/breakpoints/index.cjs",
            "default": "./dist/addons/breakpoints/index.mjs"
        },
        "./addons/breakpoints/preview": {
            "types": "./dist/addons/breakpoints/preview.d.mts",
            "import": "./dist/addons/breakpoints/preview.mjs",
            "require": "./dist/addons/breakpoints/preview.cjs",
            "default": "./dist/addons/breakpoints/preview.mjs"
        },
        "./addons/breakpoints/manager": {
            "types": "./dist/addons/breakpoints/manager.d.mts",
            "import": "./dist/addons/breakpoints/manager.mjs",
            "require": "./dist/addons/breakpoints/manager.cjs",
            "default": "./dist/addons/breakpoints/manager.mjs"
        },
        "./scss/abstracts/_aspect": "./dist/scss/abstracts/_aspect.scss",
        "./scss/abstracts/_pointer": "./dist/scss/abstracts/_pointer.scss",
        "./scss/abstracts/_state": "./dist/scss/abstracts/_state.scss",
        "./scss/abstracts/_theme": "./dist/scss/abstracts/_theme.scss",
        "./scss/abstracts/_type": "./dist/scss/abstracts/_type.scss",
        "./scss/global/_aspect": "./dist/scss/global/_aspect.scss",
        "./scss/global/_reset": "./dist/scss/global/_reset.scss",
        "./scss/global/_theme": "./dist/scss/global/_theme.scss",
        "./scss/global/_type": "./dist/scss/global/_type.scss",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "dependencies": {
        "@cjaye/utils": ">=1",
        "classnames": ">=2",
        "tabbable": ">=6"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "storybook": ">=9.2"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.3.0",
        "@cjaye/react-meta-framework": "^2.0.4",
        "@cjaye/utils": "^1.0.5",
        "@storybook/addon-a11y": ">=9",
        "@storybook/addon-designs": "^11.1.3",
        "@storybook/addon-vitest": ">=9",
        "@storybook/icons": "^2.1.0",
        "@storybook/react-vite": ">=9",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.13.3",
        "@types/opentype.js": "^1.3.10",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@unrs/resolver-binding-wasm32-wasi": "^1.12.2",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "chromatic": "^17.8.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": ">=9",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "opentype.js": "^1.3.4",
        "playwright": "^1.62.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass-embedded": "^1.102.0",
        "storybook": ">=9.2",
        "tinyglobby": "^0.2.17",
        "typescript": ">=5 <7",
        "typescript-eslint": "^8.67.0",
        "unbuild": "^3.6.1",
        "verdaccio": "^6.9.2",
        "vite": ">=7.3.6 <8",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    }
}
